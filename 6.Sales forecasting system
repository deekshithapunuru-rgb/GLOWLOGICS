from sklearn.linear_model import LinearRegression

# Month and Sales
X = [[1], [2], [3], [4], [5], [6]]
y = [100, 120, 140, 160, 180, 200]

model = LinearRegression()
model.fit(X, y)

month = int(input("Enter future month: "))
sales = model.predict([[month]])

print("Predicted Sales:", round(sales[0], 2))
