from sklearn.linear_model import LogisticRegression

# Income, Credit Score
X = [[20000, 500], [30000, 600], [50000, 700],
     [60000, 750], [80000, 800]]
y = [0, 0, 1, 1, 1]   # 0 = Rejected, 1 = Approved

model = LogisticRegression()
model.fit(X, y)

income = float(input("Enter income: "))
credit = float(input("Enter credit score: "))

result = model.predict([[income, credit]])

print("Loan Approved" if result[0] == 1 else "Loan Rejected")
